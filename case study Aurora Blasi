<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8" />
  <title>Case Study – Aurora Blasi | Elisa Costanzo</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <style>
    :root{ --primario:#355c7b; --secondario:#81277c; --bianco:#fff; --glass: rgba(7,10,20,0.78); }
    *{box-sizing:border-box;margin:0;padding:0;}
    html{scroll-behavior:smooth;}
    body{
      font-family: Calibri, "Segoe UI", Arial, sans-serif;color:var(--bianco);min-height:100vh;
      background:
        radial-gradient(circle at top left, rgba(79,123,158,0.55) 0, rgba(53,92,123,0.35) 42%, rgba(0,0,0,0) 70%),
        radial-gradient(circle at top right, rgba(129,39,124,0.50) 0, rgba(129,39,124,0.28) 38%, rgba(0,0,0,0) 70%),
        radial-gradient(circle at 40% 85%, rgba(53,92,123,0.32) 0, rgba(129,39,124,0.24) 40%, rgba(0,0,0,0) 75%),
        linear-gradient(180deg, #0b1020 0%, #120b24 52%, #070914 100%);
    }
    a{color:inherit;text-decoration:none;}

    header{
      position:sticky;top:0;z-index:50;backdrop-filter: blur(14px);
      background: linear-gradient(to right, rgba(12,18,28,0.88), rgba(26,18,43,0.72));
      border-bottom: 1px solid rgba(255,255,255,0.1);
    }
    .header-inner{max-width:1100px;margin:0 auto;padding:0.75rem 1.2rem;display:flex;align-items:center;justify-content:space-between;gap:1rem;}
    .brand{display:flex;align-items:center;gap:1rem;min-width:0;}
    .logo-wrap{display:inline-flex;align-items:center;justify-content:center;padding:6px;border-radius:12px;background:rgba(255,255,255,0.92);box-shadow:0 10px 18px rgba(0,0,0,0.28);line-height:0;}
    .logo-img{height:110px;width:auto;display:block;object-fit:contain;}
    .brand-name{font-weight:700;letter-spacing:.08em;text-transform:uppercase;font-size:1.05rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
    .brand-subtitle{font-size:.9rem;opacity:.82;line-height:1.35;max-width:56ch;}
    .header-actions{display:flex;align-items:center;gap:.55rem;flex-wrap:wrap;}
    .pill{border:1px solid rgba(255,255,255,0.55);background:transparent;color:#fff;padding:0.6rem 1.05rem;border-radius:999px;font-weight:700;cursor:pointer;display:inline-flex;align-items:center;gap:.45rem;white-space:nowrap;}
    .menu-button{border:none;background:#fff;color:var(--secondario);padding:0.6rem 1.2rem;border-radius:999px;font-weight:800;cursor:pointer;display:inline-flex;align-items:center;gap:.45rem;box-shadow:0 8px 18px rgba(0,0,0,0.35);}

    .menu-panel{position:fixed; inset:0;background:rgba(0,0,0,0.82);display:none;z-index:60;}
    .menu-panel.open{display:block;}
    .menu-panel-inner{max-width:460px;margin:5rem auto;padding:1.5rem;background: rgba(10,12,20,0.97);border-radius:1.6rem;box-shadow:0 22px 46px rgba(0,0,0,0.65);border:1px solid rgba(255,255,255,0.14);}
    .menu-panel-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:1rem;}
    .menu-panel-header h2{font-size:1rem;text-transform:uppercase;letter-spacing:.18em;font-weight:800;opacity:.92;}
    .menu-close{border:none;background:transparent;color:#fff;font-size:1.4rem;cursor:pointer;}
    .menu-list{list-style:none;margin-top:.4rem;}
    .menu-list li a{display:flex;justify-content:space-between;align-items:center;padding:.85rem .45rem;border-bottom:1px solid rgba(255,255,255,0.08);font-size:1.05rem;opacity:.93;}
    .menu-list li a span{font-size:.85rem;opacity:.7;}

    main{max-width:1100px;margin:0 auto;padding:1.6rem 1.2rem 3rem;}
    section{margin-bottom:2.6rem;}
    .section-title{font-size:1.05rem;text-transform:uppercase;letter-spacing:.2em;opacity:.9;margin-bottom:.7rem;}
    .section-subtitle{font-size:2.25rem;line-height:1.05;margin-bottom:1rem;max-width:920px;}
    .card{background:var(--glass);border:1px solid rgba(255,255,255,0.2);border-radius:1.6rem;padding:1.5rem;box-shadow:0 18px 38px rgba(0,0,0,0.5);}
    .justify p{ text-align: justify; text-justify: inter-word; }
    p{line-height:1.85;opacity:.97;font-size:1.05rem;margin-bottom:.9rem;}

    .btn{border-radius:999px;padding:0.72rem 1.25rem;font-size:1rem;font-weight:800;border:1px solid rgba(255,255,255,0.55);background:transparent;color:#fff;cursor:pointer;display:inline-flex;align-items:center;gap:.45rem;}
    .btn.primary{border-color:transparent;background:#fff;color:var(--secondario);box-shadow:0 10px 20px rgba(0,0,0,0.35);}
    .btn.link{border-color:rgba(255,255,255,0.28);background:rgba(0,0,0,0.12);}
    .actions{display:flex;gap:.7rem;flex-wrap:wrap;align-items:center;margin-top:1rem;}

    .media-grid{display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-top:1rem;}
    .media-card{border-radius:1.6rem;overflow:hidden;border:1px solid rgba(255,255,255,0.18);box-shadow:0 18px 34px rgba(0,0,0,0.5);background:rgba(0,0,0,0.18);}
    .media-head{padding:1rem;display:flex;justify-content:space-between;align-items:center;gap:.8rem;flex-wrap:wrap;border-bottom:1px solid rgba(255,255,255,0.10);}
    .media-title{font-weight:900;font-size:1.1rem;}
    .tag{font-size:.8rem;letter-spacing:.18em;text-transform:uppercase;opacity:.9;padding:.35rem .65rem;border-radius:999px;background:rgba(255,255,255,0.10);border:1px solid rgba(255,255,255,0.18);white-space:nowrap;}
    .embed{width:100%;border:0;display:block;background:#000;}
    .spotify{height:352px;}
    .yt-wrap{position:relative;padding-top:56.25%;background:#000;}
    .yt-wrap iframe{position:absolute;inset:0;width:100%;height:100%;border:0;}
    .fallback{padding:1rem;border-top:1px solid rgba(255,255,255,0.10);display:flex;gap:.6rem;flex-wrap:wrap;}

    @media (max-width:980px){ .media-grid{grid-template-columns:1fr;} .brand-subtitle{display:none;} }
    @media (max-width:600px){ .header-inner{padding-inline:.8rem;} main{padding-inline:.9rem;} .logo-img{height:90px;} .section-subtitle{font-size:1.75rem;} }
    footer{border-top:1px solid rgba(255,255,255,0.16);padding:1.2rem;text-align:center;opacity:.85;background:rgba(7,10,20,0.9);}
  </style>
</head>

<body>
<header>
  <div class="header-inner">
    <div class="brand">
      <div class="logo-wrap"><img src="Elisa Costanzo Logo.png" alt="Logo Elisa Costanzo" class="logo-img"></div>
      <div>
        <div class="brand-name">Elisa Costanzo</div>
        <div class="brand-subtitle">Case study: Aurora Blasi</div>
      </div>
    </div>
    <div class="header-actions">
      <a class="pill" href="index.html">Home</a>
      <button class="menu-button" id="menuButton">☰ Menu</button>
    </div>
  </div>
</header>

<div class="menu-panel" id="menuPanel" aria-hidden="true">
  <div class="menu-panel-inner">
    <div class="menu-panel-header">
      <h2>Menu</h2>
      <button class="menu-close" id="menuClose">✕</button>
    </div>
    <ul class="menu-list">
      <li><a href="index.html">Home <span>torna alla home</span></a></li>
      <li><a href="studio.html">ExpresSING Studio <span>pagina studio</span></a></li>
      <li><a href="percorsi.html">Percorsi <span>tutti</span></a></li>
      <li><a href="percorsi.html#ves">VES <span>sezione VES</span></a></li>
      <li><a href="case-study-aurora-blasi.html">Case study <span>questa pagina</span></a></li>
      <li><a href="index.html#contatti">Contatti <span>scrivimi</span></a></li>
    </ul>
  </div>
</div>

<main>
  <section class="justify">
    <h2 class="section-title">Case study</h2>
    <div class="section-subtitle">Percorso artistico con Aurora Blasi</div>

    <div class="card justify">
      <p>
        Qui trovi alcuni contenuti per ascoltare e vedere il progetto in modo immediato. Se gli embed non si caricano sul tuo dispositivo,
        usa i pulsanti “Apri” che trovi sotto ogni riquadro.
      </p>

      <div class="actions">
        <a class="btn primary" href="index.html#contatti">Contattami</a>
        <button class="btn link open-menu" type="button">Menu</button>
      </div>
    </div>
  </section>

  <section class="justify">
    <h2 class="section-title">Media</h2>
    <div class="section-subtitle">Brani (Spotify) e video (YouTube)</div>

    <div class="media-grid">
      <!-- Spotify 1 -->
      <div class="media-card">
        <div class="media-head"><div class="media-title">Spotify – Track</div><div class="tag">Ascolta</div></div>
        <iframe class="embed spotify" loading="lazy"
          src="https://open.spotify.com/embed/track/6G3v6KVfAQee3dlUyHrEmX"
          allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"></iframe>
        <div class="fallback">
          <a class="btn primary" target="_blank" rel="noopener noreferrer"
             href="https://open.spotify.com/track/6G3v6KVfAQee3dlUyHrEmX">Apri su Spotify →</a>
          <button class="btn link open-menu" type="button">Menu</button>
        </div>
      </div>

      <!-- Spotify 2 -->
      <div class="media-card">
        <div class="media-head"><div class="media-title">Spotify – Track</div><div class="tag">Ascolta</div></div>
        <iframe class="embed spotify" loading="lazy"
          src="https://open.spotify.com/embed/track/0A8gkT3xVZOLL7uVFJpxda"
          allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"></iframe>
        <div class="fallback">
          <a class="btn primary" target="_blank" rel="noopener noreferrer"
             href="https://open.spotify.com/track/0A8gkT3xVZOLL7uVFJpxda">Apri su Spotify →</a>
          <button class="btn link open-menu" type="button">Menu</button>
        </div>
      </div>

      <!-- YouTube 1 -->
      <div class="media-card">
        <div class="media-head"><div class="media-title">YouTube – Video</div><div class="tag">Guarda</div></div>
        <div class="yt-wrap">
          <iframe loading="lazy"
            src="https://www.youtube-nocookie.com/embed/ayLHDQ279IM"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen></iframe>
        </div>
        <div class="fallback">
          <a class="btn primary" target="_blank" rel="noopener noreferrer"
             href="https://www.youtube.com/watch?v=ayLHDQ279IM">Apri su YouTube →</a>
          <button class="btn link open-menu" type="button">Menu</button>
        </div>
      </div>

      <!-- YouTube 2 -->
      <div class="media-card">
        <div class="media-head"><div class="media-title">YouTube – Video</div><div class="tag">Guarda</div></div>
        <div class="yt-wrap">
          <iframe loading="lazy"
            src="https://www.youtube-nocookie.com/embed/dgbq1KNOPzo"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen></iframe>
        </div>
        <div class="fallback">
          <a class="btn primary" target="_blank" rel="noopener noreferrer"
             href="https://www.youtube.com/watch?v=dgbq1KNOPzo">Apri su YouTube →</a>
          <button class="btn link open-menu" type="button">Menu</button>
        </div>
      </div>
    </div>
  </section>
</main>

<footer>© <span id="year"></span> Elisa Costanzo</footer>

<script>
  document.getElementById("year").textContent = new Date().getFullYear();
  const menuButton = document.getElementById("menuButton");
  const menuPanel  = document.getElementById("menuPanel");
  const menuClose  = document.getElementById("menuClose");
  function openMenu(){ menuPanel.classList.add("open"); menuPanel.setAttribute("aria-hidden","false"); }
  function closeMenu(){ menuPanel.classList.remove("open"); menuPanel.setAttribute("aria-hidden","true"); }
  menuButton.addEventListener("click", openMenu);
  menuClose.addEventListener("click", closeMenu);
  menuPanel.addEventListener("click", (e)=>{ if(e.target===menuPanel) closeMenu(); });
  document.querySelectorAll(".menu-list a").forEach(a => a.addEventListener("click", closeMenu));
  document.querySelectorAll(".open-menu").forEach(btn => btn.addEventListener("click", openMenu));
</script>
</body>
</html>
