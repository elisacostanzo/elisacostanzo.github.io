<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8" />
  <title>Case Study – Aurora Blasi | Elisa Costanzo</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <style>
    :root{
      --primario:#355c7b; --secondario:#81277c; --bianco:#ffffff;
      --glass: rgba(7,10,20,0.78);
    }
    *{box-sizing:border-box;margin:0;padding:0;}
    html{scroll-behavior:smooth;}
    body{
      font-family: Calibri, "Segoe UI", Arial, sans-serif; color:var(--bianco);
      min-height:100vh;
      background:
        radial-gradient(circle at top left, rgba(79,123,158,0.55) 0, rgba(53,92,123,0.35) 42%, rgba(0,0,0,0) 70%),
        radial-gradient(circle at top right, rgba(129,39,124,0.50) 0, rgba(129,39,124,0.28) 38%, rgba(0,0,0,0) 70%),
        radial-gradient(circle at 40% 85%, rgba(53,92,123,0.32) 0, rgba(129,39,124,0.24) 40%, rgba(0,0,0,0) 75%),
        linear-gradient(180deg, #0b1020 0%, #120b24 52%, #070914 100%);
    }
    a{color:inherit;text-decoration:none;}

    header{
      position:sticky;top:0;z-index:50;backdrop-filter: blur(14px);
      background: linear-gradient(to right, rgba(12,18,28,0.88), rgba(26,18,43,0.72));
      border-bottom: 1px solid rgba(255,255,255,0.1);
    }
    .header-inner{
      max-width:1100px;margin:0 auto;padding:0.75rem 1.2rem;
      display:flex;align-items:center;justify-content:space-between;gap:1rem;
    }
    .brand{display:flex;align-items:center;gap:1rem;min-width:0;}
    .logo-wrap{
      display:inline-flex;align-items:center;justify-content:center;
      padding:4px;border-radius:16px;border:3px solid rgba(255,255,255,0.9);
      background: rgba(255,255,255,0.06); box-shadow: 0 14px 28px rgba(0,0,0,0.28);
      line-height:0;
    }
    .logo-img{height:130px;width:auto;display:block;object-fit:contain;}
    .brand-text{display:flex;flex-direction:column;gap:.15rem;min-width:0;}
    .brand-name{font-weight:700;letter-spacing:.08em;text-transform:uppercase;font-size:1.05rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
    .brand-subtitle{font-size:.9rem;opacity:.82;line-height:1.35;max-width:56ch;}

    .header-actions{display:flex;align-items:center;gap:.55rem;flex-wrap:wrap;}
    .pill{
      border:1px solid rgba(255,255,255,0.55);background:transparent;color:var(--bianco);
      padding:0.6rem 1.05rem;border-radius:999px;font-weight:700;cursor:pointer;
      display:inline-flex;align-items:center;gap:.45rem;white-space:nowrap;
    }
    .menu-button{
      border:none;background:var(--bianco);color:var(--secondario);
      padding:0.6rem 1.2rem;border-radius:999px;font-weight:800;cursor:pointer;
      display:inline-flex;align-items:center;gap:.45rem;
      box-shadow:0 8px 18px rgba(0,0,0,0.35);
    }

    .menu-panel{position:fixed; inset:0;background:rgba(0,0,0,0.82);display:none;z-index:60;}
    .menu-panel.open{display:block;}
    .menu-panel-inner{
      max-width:460px;margin:5rem auto;padding:1.5rem;background: rgba(10,12,20,0.97);
      border-radius:1.6rem;box-shadow:0 22px 46px rgba(0,0,0,0.65);
      border:1px solid rgba(255,255,255,0.14);
    }
    .menu-panel-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:1rem;}
    .menu-panel-header h2{font-size:1rem;text-transform:uppercase;letter-spacing:.18em;font-weight:800;opacity:.92;}
    .menu-close{border:none;background:transparent;color:var(--bianco);font-size:1.4rem;cursor:pointer;}
    .menu-list{list-style:none;margin-top:.4rem;}
    .menu-list li a{
      display:flex;justify-content:space-between;align-items:center;
      padding:.85rem .45rem;border-bottom:1px solid rgba(255,255,255,0.08);
      font-size:1.05rem;opacity:.93;
    }
    .menu-list li a span{font-size:.85rem;opacity:.7;}

    main{max-width:1100px;margin:0 auto;padding:1.6rem 1.2rem 3rem;}
    section{margin-bottom:2.6rem;}
    .section-title{font-size:1.05rem;text-transform:uppercase;letter-spacing:.2em;opacity:.9;margin-bottom:.7rem;}
    .section-subtitle{font-size:2.25rem;line-height:1.05;margin-bottom:1rem;max-width:920px;}
    .card{
      background:var(--glass);border:1px solid rgba(255,255,255,0.2);
      border-radius:1.6rem;padding:1.5rem;box-shadow:0 18px 38px rgba(0,0,0,0.5);
    }
    .justify p, .justify li{ text-align: justify; text-justify: inter-word; }
    p{line-height:1.85;opacity:.97;font-size:1.05rem;margin-bottom:.9rem;}
    ul{padding-left:1.1rem;line-height:1.75;opacity:.97;font-size:1.05rem;}
    li{margin-bottom:.35rem;}

    .btn{
      border-radius:999px;padding:0.72rem 1.25rem;font-size:1rem;font-weight:800;
      border:1px solid rgba(255,255,255,0.55);background:transparent;color:var(--bianco);
      cursor:pointer;display:inline-flex;align-items:center;gap:.45rem;
    }
    .btn.primary{border-color:transparent;background:var(--bianco);color:var(--secondario);box-shadow:0 10px 20px rgba(0,0,0,0.35);}
    .btn.link{border-color:rgba(255,255,255,0.28);background:rgba(0,0,0,0.12);}
    .actions{display:flex;gap:.7rem;flex-wrap:wrap;align-items:center;margin-top:1rem;}

    /* MEDIA GRID - molto visibile */
    .media-grid{
      display:grid;
      grid-template-columns: 1fr 1fr;
      gap:1rem;
      margin-top:1rem;
    }
    .media-card{
      border-radius:1.6rem;
      overflow:hidden;
      border:1px solid rgba(255,255,255,0.18);
      box-shadow:0 18px 34px rgba(0,0,0,0.5);
      background: rgba(0,0,0,0.18);
    }
    .media-head{
      padding:1rem 1rem .8rem;
      display:flex;align-items:center;justify-content:space-between;gap:.8rem;flex-wrap:wrap;
      border-bottom:1px solid rgba(255,255,255,0.10);
      background:
        radial-gradient(circle at 20% 30%, rgba(129,39,124,0.28), rgba(0,0,0,0) 60%),
        radial-gradient(circle at 80% 40%, rgba(53,92,123,0.26), rgba(0,0,0,0) 60%),
        rgba(7,10,20,0.40);
    }
    .media-title{font-weight:900;font-size:1.1rem;letter-spacing:.02em;}
    .media-tag{
      font-size:.8rem;letter-spacing:.18em;text-transform:uppercase;opacity:.9;
      padding:.35rem .65rem;border-radius:999px;background:rgba(255,255,255,0.10);
      border:1px solid rgba(255,255,255,0.18);
      white-space:nowrap;
    }

    .embed{
      width:100%;
      display:block;
      border:0;
      background:#000;
    }
    .spotify{height: 352px;}
    .youtube-wrap{
      position:relative;
      padding-top:56.25%;
      background:#000;
    }
    .youtube-wrap iframe{
      position:absolute;inset:0;
      width:100%;height:100%;
      border:0;
    }

    footer{
      border-top:1px solid rgba(255,255,255,0.16);
      padding:1.2rem;font-size:0.95rem;opacity:0.85;text-align:center;
      background:rgba(7,10,20,0.9);
    }

    @media (max-width: 980px){
      .media-grid{grid-template-columns:1fr;}
    }
    @media (max-width: 600px){
      .header-inner{padding-inline:.8rem;}
      main{padding-inline:.9rem;}
      .logo-img{height:95px;}
      .brand-subtitle{display:none;}
      .section-subtitle{font-size:1.75rem;}
    }
  </style>
</head>

<body>
  <header>
    <div class="header-inner">
      <div class="brand">
        <div class="logo-wrap">
          <img src="Elisa Costanzo Logo.png" alt="Logo Elisa Costanzo" class="logo-img" />
        </div>
        <div class="brand-text">
          <div class="brand-name">Elisa Costanzo</div>
          <div class="brand-subtitle">Case study: percorso artistico con Aurora Blasi</div>
        </div>
      </div>

      <div class="header-actions">
        <a class="pill" href="index.html">Home</a>
        <button class="menu-button" id="menuButton" aria-label="Apri menu">☰ Menu</button>
      </div>
    </div>
  </header>

  <div class="menu-panel" id="menuPanel" aria-hidden="true">
    <div class="menu-panel-inner">
      <div class="menu-panel-header">
        <h2>Menu</h2>
        <button class="menu-close" id="menuClose" aria-label="Chiudi menu">✕</button>
      </div>

      <ul class="menu-list">
        <li><a href="index.html">Home <span>torna alla home</span></a></li>
        <li><a href="studio.html">Studio <span>ExpresSING</span></a></li>
        <li><a href="percorsi.html">Percorsi <span>tutti i percorsi</span></a></li>
        <li><a href="ves.html">VES <span>certificazione</span></a></li>
        <li><a href="case-study-aurora-blasi.html">Case study <span>questa pagina</span></a></li>
        <li><a href="curriculum.html">Curriculum <span>pagina dedicata</span></a></li>
        <li><a href="index.html#contatti">Contatti <span>scrivimi</span></a></li>
      </ul>
    </div>
  </div>

  <main>
    <section class="justify">
      <h2 class="section-title">Case study</h2>
      <div class="section-subtitle">Percorso artistico con Aurora Blasi</div>

      <div class="card justify">
        <p>
          Un esempio di percorso che ho accompagnato fin dalle prime fasi: sviluppo tecnico, consapevolezza, identità artistica,
          costruzione della performance e lavoro mirato sui brani, fino a una direzione più solida e professionale del progetto.
        </p>
        <p>
          Qui trovi alcuni contenuti per ascoltare e vedere il lavoro in modo immediato.
        </p>

        <div class="actions">
          <a class="btn primary" href="index.html#contatti">Chiedi info / lavora con me</a>
          <button class="btn link" id="openMenuInline" type="button">Menu</button>
        </div>
      </div>
    </section>

    <section class="justify">
      <h2 class="section-title">Ascolta & guarda</h2>
      <div class="section-subtitle">Brani su Spotify e video su YouTube</div>

      <div class="media-grid">
        <!-- Spotify 1 -->
        <div class="media-card">
          <div class="media-head">
            <div class="media-title">Spotify – Track</div>
            <div class="media-tag">Ascolta</div>
          </div>
          <iframe
            class="embed spotify"
            src="https://open.spotify.com/embed/track/6G3v6KVfAQee3dlUyHrEmX"
            allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
            loading="lazy"
            title="Spotify embed 1"></iframe>
        </div>

        <!-- Spotify 2 -->
        <div class="media-card">
          <div class="media-head">
            <div class="media-title">Spotify – Track</div>
            <div class="media-tag">Ascolta</div>
          </div>
          <iframe
            class="embed spotify"
            src="https://open.spotify.com/embed/track/0A8gkT3xVZOLL7uVFJpxda"
            allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
            loading="lazy"
            title="Spotify embed 2"></iframe>
        </div>

        <!-- YouTube 1 -->
        <div class="media-card">
          <div class="media-head">
            <div class="media-title">YouTube – Video</div>
            <div class="media-tag">Guarda</div>
          </div>
          <div class="youtube-wrap">
            <iframe
              src="https://www.youtube-nocookie.com/embed/ayLHDQ279IM"
              title="YouTube video 1"
              loading="lazy"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              allowfullscreen></iframe>
          </div>
        </div>

        <!-- YouTube 2 -->
        <div class="media-card">
          <div class="media-head">
            <div class="media-title">YouTube – Video</div>
            <div class="media-tag">Guarda</div>
          </div>
          <div class="youtube-wrap">
            <iframe
              src="https://www.youtube-nocookie.com/embed/dgbq1KNOPzo"
              title="YouTube video 2"
              loading="lazy"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              allowfullscreen></iframe>
          </div>
        </div>
      </div>

      <div class="actions" style="margin-top:1.1rem;">
        <a class="btn primary" href="index.html#contatti">Contattami</a>
        <button class="btn link" id="openMenuInline2" type="button">Menu</button>
      </div>
    </section>
  </main>

  <footer>© <span id="year"></span> Elisa Costanzo – Tutti i diritti riservati.</footer>

  <script>
    document.getElementById("year").textContent = new Date().getFullYear();

    const menuButton = document.getElementById("menuButton");
    const menuPanel  = document.getElementById("menuPanel");
    const menuClose  = document.getElementById("menuClose");
    const openMenuInline = document.getElementById("openMenuInline");
    const openMenuInline2 = document.getElementById("openMenuInline2");

    function openMenu(){ menuPanel.classList.add("open"); menuPanel.setAttribute("aria-hidden","false"); }
    function closeMenu(){ menuPanel.classList.remove("open"); menuPanel.setAttribute("aria-hidden","true"); }

    menuButton.addEventListener("click", openMenu);
    openMenuInline.addEventListener("click", openMenu);
    openMenuInline2.addEventListener("click", openMenu);
    menuClose.addEventListener("click", closeMenu);
    menuPanel.addEventListener("click", (e)=>{ if(e.target===menuPanel) closeMenu(); });
    document.querySelectorAll(".menu-list a").forEach(a => a.addEventListener("click", closeMenu));
  </script>
</body>
</html>

